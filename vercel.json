{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/check.js",
  "outputDirectory": "public",
  "functions": {
    "api/gateway.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/rpc.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/telegram.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/mcp.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/automation.js": {
      "maxDuration": 60
    },
    "api/agent-worker.js": {
      "maxDuration": 300,
      "memory": 1024,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "mine-agent-tasks"
        }
      ]
    },
    "api/automation-worker.js": {
      "maxDuration": 300,
      "memory": 1024,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "mine-automation-schedule"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/v1",
      "destination": "/api/gateway?__p="
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/gateway?__p=:path*"
    },
    {
      "source": "/health",
      "destination": "/api/gateway?__p=__health"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
