{
  "name": "Mine Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Mine Console",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm install --no-audit --no-fund",
  "postStartCommand": "bash -lc 'if ! curl -fsS http://127.0.0.1:3000/health >/dev/null 2>&1; then nohup npm run dev > /tmp/mine-dev.log 2>&1 < /dev/null & fi'",
  "remoteEnv": {
    "PORT": "3000"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
